; Salin file ini menjadi config.ini lalu isi bagian [database].
; config.ini tidak ikut ter-commit karena berisi password.

[database]
host = 127.0.0.1
port = 3306
user = energi
password = ISI_PASSWORD_DISINI
database = energy

[dashboard]
; 127.0.0.1 = hanya bisa dibuka dari komputer ini saja.
; 0.0.0.0   = bisa dibuka dari komputer lain di jaringan (untuk server).
; Port harus dibuka juga di Windows Firewall, dan untuk jaringan pabrik di sini
; dipakai 40000.
host = 0.0.0.0
port = 40000

[history]
; Seberapa sering counter kWh dicatat ke database (menit).
; 1 = profil beban per jam jadi lebih halus (±158 MB/tahun untuk 5 meter).
sample_minutes = 1
; Jam penutupan hari laporan:
;   0  = hari kalender biasa (00:00 - 24:00)
;   22 = siklus tarif (22:00 hari sebelumnya s/d 22:00 hari itu)
day_end_hour = 0
